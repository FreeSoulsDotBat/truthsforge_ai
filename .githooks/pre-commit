#!/bin/sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/quality.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/quality.ps1
else
  echo "PowerShell 7 (pwsh) or Windows PowerShell is required to run the Truth's Forge AI quality gate." >&2
  exit 1
fi
