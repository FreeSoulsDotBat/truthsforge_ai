FROM node:22-alpine

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /workspace/
COPY apps/web/package.json /workspace/apps/web/package.json
COPY apps/docs/package.json /workspace/apps/docs/package.json
COPY apps/desktop/package.json /workspace/apps/desktop/package.json
COPY apps/mobile/package.json /workspace/apps/mobile/package.json
COPY packages/types/package.json /workspace/packages/types/package.json
COPY packages/ui/package.json /workspace/packages/ui/package.json

RUN pnpm install --frozen-lockfile --store-dir /pnpm/store

EXPOSE 3000

CMD ["sh", "-lc", "CI=true pnpm install --frozen-lockfile --store-dir /pnpm/store && pnpm --filter @truths-forge/docs dev"]
